+class TestReadGuards(Base):
+    def _fail_write(self, fail_name, times=1):
+        orig = m.write_atomic
+        state = {"n": 0}
+
+        def wrapper(dirpath, name, data, mode=0o640, overwrite=True):
+            if name == fail_name and state["n"] < times:
+                state["n"] += 1
+                raise OSError(28, "No space left on device")
+            return orig(dirpath, name, data, mode, overwrite)
+
+        m.write_atomic = wrapper
+        self.addCleanup(setattr, m, "write_atomic", orig)
+
+    def _status(self):
+        with open(os.path.join(self.tok_dir, "status.json")) as f:
+            return json.load(f)
+
+    def test_second_read_refused_before_any_network_call(self):
+        self.assertEqual(run_main(["read"])[0], 0)
+        tp = os.path.join(self.tok_dir, "token")
+        with open(tp) as f:
+            before = f.read()
+        Fake.log = []
+        code, out, err = run_main(["read"])
+        self.assertEqual(code, 1)
+        self.assertEqual(Fake.log, [])
+        self.assertIn("уже существует", err)
+        with open(tp) as f:
+            self.assertEqual(f.read(), before)
+
+    def test_foreign_token_file_is_not_overwritten_and_no_token_issued(self):
+        tp = os.path.join(self.tok_dir, "token")
+        with open(tp, "w") as f:
+            f.write("keep-me\n")
+        code, out, err = run_main(["read"])
+        self.assertEqual(code, 1)
+        self.assertEqual(Fake.log, [])
+        with open(tp) as f:
+            self.assertEqual(f.read(), "keep-me\n")
+
+    def test_token_write_failure_revokes_with_verification_and_leaves_clean_state(self):
+        self._fail_write("token")
+        code, out, err = run_main(["read"])
+        self.assertEqual(code, 1)
+        self.assertFalse(os.path.lexists(os.path.join(self.tok_dir, "token")))
+        paths = [(x[0], x[1]) for x in Fake.log]
+        self.assertIn(("DELETE", "/installation/token"), paths)
+        self.assertIn(("GET", "/installation/repositories"), paths)
