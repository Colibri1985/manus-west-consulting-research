+def abort_after_issue(token, expires_at):
+    """Запись после выпуска не удалась: отозвать токен с проверкой и привести каталог в чистое состояние.
+
+    Файл token удаляется только если он наш (содержимое совпадает) и отзыв подтверждён.
+    """
+    state, detail = revoke_and_verify(token)
+    path = os.path.join(TOKEN_DIR, "token")
+    notes = []
+    try:
+        if os.path.lexists(path):
+            try:
+                ours = (read_token_file(path) == token)
+            except Fail:
+                ours = False
+            if not ours:
+                notes.append("найденный файл токена не наш, не тронут")
+            elif state in CONFIRMED_STATES:
+                os.unlink(path)
+                notes.append("файл токена удалён")
+            else:
+                notes.append("файл токена оставлен для повторного отзыва: athena-github-token off")
+        else:
+            notes.append("файла токена нет")
+        _cleanup_tmp()
+    except OSError as e:
+        notes.append("ошибка очистки: " + type(e).__name__)
+    present = os.path.lexists(path)
+    status = {"token_present": present, "issue_failed": True, "revocation": state,
+              "expires_at": expires_at, "failed_at": now_iso()}
+    try:
+        write_atomic(TOKEN_DIR, "status.json",
+                     (json.dumps(status, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8"))
+    except Exception:
+        notes.append("status.json не обновлён")
+    text = "отзыв токена: %s (%s); %s" % (state, detail, "; ".join(notes))
+    if state not in CONFIRMED_STATES:
+        text += ". ВНИМАНИЕ: токен может оставаться действительным до %s" % redact(expires_at)[:40]
+    return text
+
