+def check_expires(value):
+    """Возвращает текст проблемы или None."""
+    if not isinstance(value, str):
+        return "в ответе нет expires_at"
+    try:
+        dt = datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
+    except ValueError:
+        return "expires_at не в ожидаемом формате"
+    left = dt.timestamp() - time.time()
+    if left <= 0:
+        return "expires_at уже в прошлом"
+    if left > MAX_TOKEN_LIFETIME:
+        return "expires_at слишком далеко (%d с)" % left
+    return None
 
 
