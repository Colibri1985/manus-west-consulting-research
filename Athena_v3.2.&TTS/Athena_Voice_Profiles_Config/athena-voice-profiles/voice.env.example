# Merge into Hermes .env or inject into the runtime environment; chmod 600.
# Never use the Honcho/ChatGPT token in place of the provider key.
OPENROUTER_TTS_API_KEY=
FISH_TTS_API_KEY=

# Explicit gate before paid synthesis. Keep false until permitted and tested.
ATHENA_PAID_TTS_ENABLED=false
ATHENA_TTS_MAX_INPUT_CHARS=4000
# This per-request cap is not a monthly budget. Set a monthly limit externally before activation.
