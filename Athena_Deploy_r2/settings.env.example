# No credentials. All image references must be approved repo@sha256:64hex.
HERMES_IMAGE=REPLACE
EXECUTOR_IMAGE=REPLACE
HONCHO_IMAGE=REPLACE
HONCHO_POSTGRES_IMAGE=REPLACE
REDIS_IMAGE=REPLACE
CATALOG_IMAGE=REPLACE
TEAM_CONTROL_IMAGE=REPLACE
TEAM_POSTGRES_IMAGE=REPLACE
SECRET_DIR=/etc/athena/secrets
HERMES_HOME_HOST=/srv/athena/state/hermes/default
EXECUTOR_INPUTS=/srv/athena/state/executor/inputs
EXECUTOR_WORK=/srv/athena/work/jobs/personal-default
EXECUTOR_HOME=/srv/athena/state/executor/home
HONCHO_DATA_ROOT=/srv/athena/honcho-data
HONCHO_DATA_UUID=REPLACE
WAREHOUSE_ROOT=/srv/athena/warehouse
CATALOG_STATE=/srv/athena/state/catalog
TEAM_STATE=/srv/athena/state/team
TEAM_WORK=/srv/athena/workshop/workspaces
TEAM_PGDATA=/srv/athena/control/db
GOVERNANCE_ROOT=/srv/athena/control/governance/approved
HERMES_MEMORY=2g
HERMES_CPUS=1.0
EXECUTOR_MEMORY=1g
EXECUTOR_CPUS=0.75
HONCHO_DB_MEMORY=3g
HONCHO_DB_CPUS=1.0
HONCHO_API_MEMORY=1g
HONCHO_API_CPUS=0.5
HONCHO_DERIVER_MEMORY=1536m
HONCHO_DERIVER_CPUS=1.0
REDIS_MEMORY=512m
REDIS_CPUS=0.25
REDIS_MAXMEMORY=192mb
CATALOG_MEMORY=512m
CATALOG_CPUS=0.5
TEAM_MEMORY=1g
TEAM_CPUS=0.75
TEAM_DB_MEMORY=1g
TEAM_DB_CPUS=0.5
# Approval is not proof; operator must measure other active host workloads.
HOST_RESERVE_GIB=2
OTHER_WORKLOAD_GIB=REPLACE
