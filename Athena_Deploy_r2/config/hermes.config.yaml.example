# Merge into native config; validate every key against pinned release.
model:
  provider: REPLACE
  default: REPLACE
terminal:
  backend: ssh
  persistent_shell: false
  cwd: /workspace
  env_passthrough: []
memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: true
skills:
  write_approval: true
security:
  allow_lazy_installs: false
  redact_secrets: true
database:
  journal_mode: wal
  synchronous: FULL
tts:
  provider: edge
  edge:
    voice: ru-RU-SvetlanaNeural
    speed: 1.0
