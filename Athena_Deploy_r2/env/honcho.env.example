# Upstream compatibility must be verified against accepted source commit.
AUTH_USE_AUTH=true
API_WORKERS=1
DERIVER_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CACHE_ENABLED=true
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false
EMBED_MESSAGES=true
DERIVER_ENABLED=true
DERIVER_FLUSH_ENABLED=true
DREAM_ENABLED=true
DREAM_SURPRISAL__ENABLED=false
SUMMARY_ENABLED=true
PEER_CARD_ENABLED=true
EMBEDDING_VECTOR_DIMENSIONS=1536
EMBEDDING_MAX_INPUT_TOKENS=8191
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=openai/text-embedding-3-large
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
LOG_LEVEL=INFO
TELEMETRY_ENABLED=false
TELEMETRY_TRACE_PAYLOADS_ENABLED=false
SENTRY_ENABLED=false
